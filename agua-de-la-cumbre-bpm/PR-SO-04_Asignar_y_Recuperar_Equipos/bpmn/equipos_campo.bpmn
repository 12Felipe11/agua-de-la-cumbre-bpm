<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_equipos_campo" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_DevolucionEquipo" name="DevolucionEquipo" />
  <bpmn:collaboration id="Collab_equipos_campo">
    <bpmn:participant id="Participant_equipos_campo" name="PR-SO-04 Asignar y Recuperar Equipos de Campo" processRef="equipos_campo" />
    <bpmn:participant id="Ext_Sol" name="Cliente / Vendedor" />
    <bpmn:messageFlow id="Msg_equipos_campo_1" name="Solicitud" sourceRef="Ext_Sol" targetRef="verificar" />
    <bpmn:messageFlow id="Msg_equipos_campo_2" name="No disponible" sourceRef="informar" targetRef="Ext_Sol" />
    <bpmn:messageFlow id="Msg_equipos_campo_3" name="Equipo y acta" sourceRef="entregar" targetRef="Ext_Sol" />
    <bpmn:messageFlow id="Msg_equipos_campo_4" name="Devolución" sourceRef="Ext_Sol" targetRef="devol" />
  </bpmn:collaboration>
  <bpmn:process id="equipos_campo" name="PR-SO-04 Asignar y Recuperar Equipos de Campo" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_equipos_campo">
      <bpmn:lane id="Lane_Pla" name="Responsable de Planta">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>asignar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>constancia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tec" name="Operario de Planta">
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>devol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>estado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reintegrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Solicitud de equipo recibida" camunda:formRef="eq_solicitud" camunda:formRefBinding="latest"><bpmn:outgoing>Flow_equipos_campo_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="verificar" name="Consultar disponibilidad en el inventario de equipos" camunda:type="external" camunda:topic="consultar-inventario-equipos"><bpmn:incoming>Flow_equipos_campo_1</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Equipo disponible?" default="Flow_equipos_campo_4"><bpmn:incoming>Flow_equipos_campo_2</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_3</bpmn:outgoing><bpmn:outgoing>Flow_equipos_campo_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="asignar" name="Asignar el equipo y diligenciar el acta de entrega" camunda:formRef="eq_acta_entrega" camunda:formRefBinding="latest" camunda:candidateGroups="administracion"><bpmn:incoming>Flow_equipos_campo_3</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="constancia" name="Generar constancia del acta (JavaScript)" camunda:type="external" camunda:topic="constancia-acta-equipo"><bpmn:incoming>Flow_equipos_campo_6</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="informar" name="Informar la indisponibilidad" camunda:formRef="seguimiento" camunda:formRefBinding="latest" camunda:candidateGroups="administracion"><bpmn:incoming>Flow_equipos_campo_4</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e0" name="Solicitud no atendida"><bpmn:incoming>Flow_equipos_campo_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:parallelGateway id="a1"><bpmn:incoming>Flow_equipos_campo_7</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_8</bpmn:outgoing><bpmn:outgoing>Flow_equipos_campo_9</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="registrar" name="Registrar la asignación y actualizar el inventario" camunda:type="external" camunda:topic="actualizar-inventario-equipos"><bpmn:incoming>Flow_equipos_campo_9</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="entregar" name="Entregar el equipo al cliente o vendedor"><bpmn:incoming>Flow_equipos_campo_8</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:parallelGateway id="a2"><bpmn:incoming>Flow_equipos_campo_10</bpmn:incoming><bpmn:incoming>Flow_equipos_campo_11</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_12</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:eventBasedGateway id="eb"><bpmn:incoming>Flow_equipos_campo_12</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_13</bpmn:outgoing><bpmn:outgoing>Flow_equipos_campo_14</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="vence" name="Vence la asignación"><bpmn:documentation>Plazo configurable en application.yaml (agua.plazos.asignacion). Valor propuesto para operación: P30D.</bpmn:documentation><bpmn:incoming>Flow_equipos_campo_13</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_16</bpmn:outgoing><bpmn:timerEventDefinition id="TED_vence"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${plazoAsignacion}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="devol" name="Cliente o vendedor solicita la devolución"><bpmn:incoming>Flow_equipos_campo_14</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_15</bpmn:outgoing><bpmn:messageEventDefinition id="MED_devol" messageRef="Message_DevolucionEquipo" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g4"><bpmn:incoming>Flow_equipos_campo_15</bpmn:incoming><bpmn:incoming>Flow_equipos_campo_16</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="recibir" name="Recibir el equipo devuelto"><bpmn:incoming>Flow_equipos_campo_17</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_18</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="estado" name="Verificar el estado del equipo y firmar el acta de devolución" camunda:formRef="eq_acta_devolucion" camunda:formRefBinding="latest" camunda:candidateGroups="bodega"><bpmn:incoming>Flow_equipos_campo_18</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_19</bpmn:outgoing></bpmn:userTask>
    <bpmn:businessRuleTask id="disp" name="Definir la disposición del equipo" camunda:resultVariable="disposicion" camunda:decisionRef="disposicion_equipo" camunda:decisionRefBinding="latest" camunda:mapDecisionResult="singleEntry"><bpmn:incoming>Flow_equipos_campo_19</bpmn:incoming><bpmn:incoming>Flow_equipos_campo_23</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_20</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g2" name="¿Requiere mantenimiento?" default="Flow_equipos_campo_22"><bpmn:incoming>Flow_equipos_campo_20</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_21</bpmn:outgoing><bpmn:outgoing>Flow_equipos_campo_22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="mant" name="Realizar el mantenimiento del equipo" calledElement="mantenimiento_equipo" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in variables="all" /><camunda:out variables="all" /></bpmn:extensionElements><bpmn:incoming>Flow_equipos_campo_21</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_23</bpmn:outgoing></bpmn:callActivity>
    <bpmn:serviceTask id="reintegrar" name="Registrar la devolución y reintegrar al inventario" camunda:type="external" camunda:topic="actualizar-inventario-equipos"><bpmn:incoming>Flow_equipos_campo_22</bpmn:incoming><bpmn:outgoing>Flow_equipos_campo_24</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Acta de devolución firmada e inventario actualizado"><bpmn:incoming>Flow_equipos_campo_24</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_equipos_campo_1" sourceRef="s" targetRef="verificar" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_2" sourceRef="verificar" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_3" name="Sí" sourceRef="g1" targetRef="asignar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${equipoDisponible}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_equipos_campo_4" name="No" sourceRef="g1" targetRef="informar" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_5" sourceRef="informar" targetRef="e0" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_6" sourceRef="asignar" targetRef="constancia" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_7" sourceRef="constancia" targetRef="a1" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_8" sourceRef="a1" targetRef="entregar" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_9" sourceRef="a1" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_10" sourceRef="entregar" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_11" sourceRef="registrar" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_12" sourceRef="a2" targetRef="eb" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_13" sourceRef="eb" targetRef="vence" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_14" sourceRef="eb" targetRef="devol" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_15" sourceRef="devol" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_16" sourceRef="vence" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_17" sourceRef="g4" targetRef="recibir" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_18" sourceRef="recibir" targetRef="estado" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_19" sourceRef="estado" targetRef="disp" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_20" sourceRef="disp" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_21" name="Sí" sourceRef="g2" targetRef="mant"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${disposicion == 'MANTENIMIENTO'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_equipos_campo_22" name="No" sourceRef="g2" targetRef="reintegrar" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_23" sourceRef="mant" targetRef="disp" />
    <bpmn:sequenceFlow id="Flow_equipos_campo_24" sourceRef="reintegrar" targetRef="e1" />
  </bpmn:process>
