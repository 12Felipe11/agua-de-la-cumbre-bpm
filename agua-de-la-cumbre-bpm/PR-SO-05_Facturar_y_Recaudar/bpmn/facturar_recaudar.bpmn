<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_facturar_recaudar" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_VentaEntregada" name="VentaEntregada" />
  <bpmn:message id="Message_FacturaEnviada" name="FacturaEnviada" />
  <bpmn:message id="Message_PagoRecibido" name="PagoRecibido" />
  <bpmn:collaboration id="Collab_facturar_recaudar">
    <bpmn:participant id="Participant_facturar_recaudar" name="PR-SO-05 Facturar y Recaudar las Ventas (Cartera)" processRef="facturar_recaudar" />
    <bpmn:participant id="Ext_Cli" name="Cliente" />
    <bpmn:messageFlow id="Msg_facturar_recaudar_1" name="Factura" sourceRef="enviar" targetRef="Ext_Cli" />
    <bpmn:messageFlow id="Msg_facturar_recaudar_2" name="Pago" sourceRef="Ext_Cli" targetRef="pago" />
  </bpmn:collaboration>
  <bpmn:process id="facturar_recaudar" name="PR-SO-05 Facturar y Recaudar las Ventas (Cartera)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_facturar_recaudar">
      <bpmn:lane id="Lane_Fin" name="Responsable Administrativo y Financiero">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>soporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>factura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cxc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regpago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cobro</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Venta recibida de PR-CO-03"><bpmn:outgoing>Flow_facturar_recaudar_1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s" messageRef="Message_VentaEntregada" /></bpmn:startEvent>
    <bpmn:startEvent id="s0" name="Venta registrada manualmente" camunda:formRef="fin_venta_manual" camunda:formRefBinding="latest"><bpmn:outgoing>Flow_facturar_recaudar_2</bpmn:outgoing></bpmn:startEvent>
    <bpmn:callActivity id="soporte" name="Revisar el soporte de la venta" calledElement="revisar_soporte" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in sourceExpression="{'facturar_recaudar'}" target="procesoOrigen" /><camunda:in source="pedidoId" target="referenciaOperacion" /><camunda:out source="soporteReferencia" target="soporteReferencia" /><camunda:out source="observacionesSoporte" target="observacionesSoporte" /></bpmn:extensionElements><bpmn:incoming>Flow_facturar_recaudar_1</bpmn:incoming><bpmn:incoming>Flow_facturar_recaudar_2</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_3</bpmn:outgoing></bpmn:callActivity>
    <bpmn:serviceTask id="registrar" name="Registrar la venta en la cuenta del cliente" camunda:type="external" camunda:topic="registrar-venta"><bpmn:incoming>Flow_facturar_recaudar_3</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="factura" name="Generar la factura" camunda:type="external" camunda:topic="generar-factura"><bpmn:incoming>Flow_facturar_recaudar_4</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="a1"><bpmn:incoming>Flow_facturar_recaudar_5</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_6</bpmn:outgoing><bpmn:outgoing>Flow_facturar_recaudar_7</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="enviar" name="Enviar la factura al cliente (JavaScript)"><bpmn:incoming>Flow_facturar_recaudar_7</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_9</bpmn:outgoing><bpmn:messageEventDefinition id="MED_enviar" messageRef="Message_FacturaEnviada" camunda:type="external" camunda:topic="enviar-factura" /></bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="cxc" name="Registrar la cuenta por cobrar" camunda:type="external" camunda:topic="registrar-cuenta-por-cobrar"><bpmn:incoming>Flow_facturar_recaudar_6</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="a2"><bpmn:incoming>Flow_facturar_recaudar_8</bpmn:incoming><bpmn:incoming>Flow_facturar_recaudar_9</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_10</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:eventBasedGateway id="eb"><bpmn:incoming>Flow_facturar_recaudar_10</bpmn:incoming><bpmn:incoming>Flow_facturar_recaudar_17</bpmn:incoming><bpmn:incoming>Flow_facturar_recaudar_23</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_11</bpmn:outgoing><bpmn:outgoing>Flow_facturar_recaudar_12</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="pago" name="Pago recibido del cliente"><bpmn:incoming>Flow_facturar_recaudar_11</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_13</bpmn:outgoing><bpmn:messageEventDefinition id="MED_pago" messageRef="Message_PagoRecibido" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="vence" name="Vence el plazo de pago"><bpmn:documentation>Plazo configurable en application.yaml (agua.plazos.pago). Valor propuesto para operación: P30D.</bpmn:documentation><bpmn:incoming>Flow_facturar_recaudar_12</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_21</bpmn:outgoing><bpmn:timerEventDefinition id="TED_vence"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${plazoPago}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="regpago" name="Registrar el pago" camunda:formRef="fin_pago" camunda:formRefBinding="latest" camunda:candidateGroups="tesoreria"><bpmn:incoming>Flow_facturar_recaudar_13</bpmn:incoming><bpmn:incoming>Flow_facturar_recaudar_20</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="concil" name="Conciliar y actualizar la cartera" calledElement="conciliar_cartera" camunda:calledElementBinding="latest"><bpmn:extensionElements><camunda:in variables="all" /><camunda:out variables="all" /></bpmn:extensionElements><bpmn:incoming>Flow_facturar_recaudar_14</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_15</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="g1" name="¿Estado de la cartera?" default="Flow_facturar_recaudar_18"><bpmn:incoming>Flow_facturar_recaudar_15</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_16</bpmn:outgoing><bpmn:outgoing>Flow_facturar_recaudar_17</bpmn:outgoing><bpmn:outgoing>Flow_facturar_recaudar_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="reporte" name="Reportar el estado de cartera" camunda:formRef="fin_reporte" camunda:formRefBinding="latest" camunda:candidateGroups="administracion"><bpmn:incoming>Flow_facturar_recaudar_16</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_19</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e1" name="Cuenta saldada y cartera conciliada"><bpmn:incoming>Flow_facturar_recaudar_19</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="corregir" name="Revisar diferencias y corregir el registro" camunda:formRef="seguimiento" camunda:formRefBinding="latest" camunda:candidateGroups="tesoreria"><bpmn:incoming>Flow_facturar_recaudar_18</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_20</bpmn:outgoing></bpmn:userTask>
    <bpmn:businessRuleTask id="accion" name="Definir la acción de cobro" camunda:resultVariable="accionCobro" camunda:decisionRef="accion_cobro" camunda:decisionRefBinding="latest" camunda:mapDecisionResult="singleEntry"><bpmn:incoming>Flow_facturar_recaudar_21</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_22</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:userTask id="cobro" name="Gestionar el cobro de la cuenta vencida" camunda:formRef="fin_cobro" camunda:formRefBinding="latest" camunda:candidateGroups="tesoreria"><bpmn:incoming>Flow_facturar_recaudar_22</bpmn:incoming><bpmn:outgoing>Flow_facturar_recaudar_23</bpmn:outgoing></bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_1" sourceRef="s" targetRef="soporte" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_2" sourceRef="s0" targetRef="soporte" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_3" sourceRef="soporte" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_4" sourceRef="registrar" targetRef="factura" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_5" sourceRef="factura" targetRef="a1" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_6" sourceRef="a1" targetRef="cxc" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_7" sourceRef="a1" targetRef="enviar" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_8" sourceRef="cxc" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_9" sourceRef="enviar" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_10" sourceRef="a2" targetRef="eb" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_11" sourceRef="eb" targetRef="pago" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_12" sourceRef="eb" targetRef="vence" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_13" sourceRef="pago" targetRef="regpago" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_14" sourceRef="regpago" targetRef="concil" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_15" sourceRef="concil" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_16" name="Cerrada" sourceRef="g1" targetRef="reporte"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${estadoCartera == 'CERRADA'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_17" name="Pendiente" sourceRef="g1" targetRef="eb"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${estadoCartera == 'PENDIENTE'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_18" name="Revisar" sourceRef="g1" targetRef="corregir" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_19" sourceRef="reporte" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_20" sourceRef="corregir" targetRef="regpago" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_21" sourceRef="vence" targetRef="accion" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_22" sourceRef="accion" targetRef="cobro" />
    <bpmn:sequenceFlow id="Flow_facturar_recaudar_23" sourceRef="cobro" targetRef="eb" />
  </bpmn:process>
