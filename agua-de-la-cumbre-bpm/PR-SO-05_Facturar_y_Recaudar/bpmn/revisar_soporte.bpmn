      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="637" y="122" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="600" y="160" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
