  <bpmn:collaboration id="Collab_revisar_soporte">
    <bpmn:participant id="Participant_revisar_soporte" name="PR-SO-05 (subproceso) Revisar soporte documental" processRef="revisar_soporte" />
  </bpmn:collaboration>
  <bpmn:process id="revisar_soporte" name="PR-SO-05 (subproceso) Revisar soporte documental" isExecutable="true" camunda:historyTimeToLive="180" camunda:isStartableInTasklist="false">
    <bpmn:laneSet id="LaneSet_revisar_soporte">
      <bpmn:lane id="Lane_Adm" name="Administración">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>soporte_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Solicitud recibida"><bpmn:outgoing>Flow_revisar_soporte_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="soporte_revisar" name="Revisar soporte documental" camunda:formRef="revision_soporte" camunda:formRefBinding="latest" camunda:candidateGroups="administracion"><bpmn:incoming>Flow_revisar_soporte_1</bpmn:incoming><bpmn:outgoing>Flow_revisar_soporte_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e" name="Soporte revisado"><bpmn:incoming>Flow_revisar_soporte_2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_revisar_soporte_1" sourceRef="s" targetRef="soporte_revisar" />
    <bpmn:sequenceFlow id="Flow_revisar_soporte_2" sourceRef="soporte_revisar" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_revisar_soporte">
    <bpmndi:BPMNPlane id="Plane_revisar_soporte" bpmnElement="Collab_revisar_soporte">
      <bpmndi:BPMNShape id="Participant_revisar_soporte_di" bpmnElement="Participant_revisar_soporte" isHorizontal="true"><dc:Bounds x="160" y="80" width="630" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Adm_di" bpmnElement="Lane_Adm" isHorizontal="true"><dc:Bounds x="190" y="80" width="600" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="277" y="122" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="240" y="160" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
