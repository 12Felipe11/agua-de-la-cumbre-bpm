      "label": "Equipo",
      "type": "textfield",
      "id": "Field_equipoId",
      "validate": {},
      "disabled": true
    },
    {
      "key": "informeMantenimiento",
      "label": "Informe técnico del mantenimiento",
      "type": "textfield",
      "id": "Field_informeMantenimiento",
      "validate": {
        "required": true
      },
      "defaultValue": "INF-MANT-001"
    },
    {
      "key": "equipoApto",
      "label": "Equipo recuperado y apto",
