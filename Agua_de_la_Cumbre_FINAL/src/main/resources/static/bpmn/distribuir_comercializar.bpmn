<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_distribuir_comercializar" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_PedidoRecibido" name="PedidoRecibido" />
  <bpmn:message id="Message_VentaEntregada" name="VentaEntregada" />
  <bpmn:message id="Message_LoteLiberado" name="LoteLiberado" />
  <bpmn:error id="Error_SIN_STOCK" name="SIN_STOCK" errorCode="SIN_STOCK" />
  <bpmn:collaboration id="Collab_distribuir_comercializar">
    <bpmn:participant id="Participant_distribuir_comercializar" name="PR-CO-03 Distribuir y Comercializar el Producto Terminado" processRef="distribuir_comercializar" />
    <bpmn:participant id="Ext_Cli" name="Cliente / Distribuidor" />
    <bpmn:messageFlow id="Msg_distribuir_comercializar_1" name="Pedido" sourceRef="Ext_Cli" targetRef="s" />
    <bpmn:messageFlow id="Msg_distribuir_comercializar_2" name="Aviso de demora" sourceRef="demora" targetRef="Ext_Cli" />
    <bpmn:messageFlow id="Msg_distribuir_comercializar_3" name="Producto entregado" sourceRef="entregar" targetRef="Ext_Cli" />
  </bpmn:collaboration>
  <bpmn:process id="distribuir_comercializar" name="Distribuir y Comercializar el Producto Terminado" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_distribuir_comercializar">
      <bpmn:lane id="Lane_Ven" name="Ventas y Despacho">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>organizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sinstock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trasladar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pla" name="Líder y Operario de Planta (Almacén)">
        <bpmn:flowNodeRef>consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alistar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>demora</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloquear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reprog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Pedido recibido del cliente o distribuidor"><bpmn:outgoing>Flow_distribuir_comercializar_1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s" messageRef="Message_PedidoRecibido" /></bpmn:startEvent>
    <bpmn:userTask id="registrar" name="Registrar el pedido y asociarlo al cliente" camunda:formRef="dist_pedido" camunda:formRefBinding="deployment" camunda:candidateGroups="vendedores"><bpmn:incoming>Flow_distribuir_comercializar_1</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="consultar" name="Consultar lote, vigencia y existencias" camunda:delegateExpression="${distribucionDelegate}"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="accion">consultar</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_distribuir_comercializar_2</bpmn:incoming><bpmn:incoming>Flow_distribuir_comercializar_25</bpmn:incoming><bpmn:incoming>Flow_distribuir_comercializar_28</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:businessRuleTask id="validar" name="Validar lote liberado, vigente y existencias" camunda:resultVariable="despacho" camunda:decisionRef="validar_despacho" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleEntry"><bpmn:incoming>Flow_distribuir_comercializar_3</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_4</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g1" name="¿Se puede despachar?" default="Flow_distribuir_comercializar_7"><bpmn:incoming>Flow_distribuir_comercializar_4</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_5</bpmn:outgoing><bpmn:outgoing>Flow_distribuir_comercializar_6</bpmn:outgoing><bpmn:outgoing>Flow_distribuir_comercializar_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="a1"><bpmn:incoming>Flow_distribuir_comercializar_5</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_9</bpmn:outgoing><bpmn:outgoing>Flow_distribuir_comercializar_10</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:manualTask id="alistar" name="Alistar el pedido con lotes liberados"><bpmn:incoming>Flow_distribuir_comercializar_9</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_11</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="organizar" name="Organizar el pedido por zona y vendedor" camunda:formRef="dist_preparar" camunda:formRefBinding="deployment" camunda:candidateGroups="vendedores"><bpmn:incoming>Flow_distribuir_comercializar_10</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="a2"><bpmn:incoming>Flow_distribuir_comercializar_11</bpmn:incoming><bpmn:incoming>Flow_distribuir_comercializar_12</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_13</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="g2" name="¿Canal de entrega?" default="Flow_distribuir_comercializar_15"><bpmn:incoming>Flow_distribuir_comercializar_13</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_14</bpmn:outgoing><bpmn:outgoing>Flow_distribuir_comercializar_15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="entregar" name="Entregar el producto al cliente y registrar el comprobante" camunda:formRef="dist_comprobante" camunda:formRefBinding="deployment" camunda:candidateGroups="vendedores"><bpmn:incoming>Flow_distribuir_comercializar_14</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_16</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="canal" name="Intercambiar envases vacíos por llenos" calledElement="intercambio_envases" camunda:calledElementBinding="deployment"><bpmn:extensionElements><camunda:in variables="all" /><camunda:out variables="all" /></bpmn:extensionElements><bpmn:incoming>Flow_distribuir_comercializar_15</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_17</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="g3"><bpmn:incoming>Flow_distribuir_comercializar_16</bpmn:incoming><bpmn:incoming>Flow_distribuir_comercializar_17</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="salida" name="Registrar salida (F-AC-PT-002): lote y cantidad" camunda:delegateExpression="${distribucionDelegate}"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="accion">salida</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_distribuir_comercializar_18</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="sinstock" name="Sin existencias" attachedToRef="salida"><bpmn:outgoing>Flow_distribuir_comercializar_21</bpmn:outgoing><bpmn:errorEventDefinition id="EED_sinstock" errorRef="Error_SIN_STOCK" /></bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="trasladar" name="Venta trasladada a PR-SO-05"><bpmn:incoming>Flow_distribuir_comercializar_19</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_20</bpmn:outgoing><bpmn:messageEventDefinition id="MED_trasladar" messageRef="Message_VentaEntregada" camunda:type="external" camunda:topic="trasladar-venta" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e1" name="Producto entregado y venta registrada"><bpmn:incoming>Flow_distribuir_comercializar_20</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="demora" name="Informar la demora al cliente" camunda:formRef="seguimiento" camunda:formRefBinding="deployment" camunda:candidateGroups="bodega"><bpmn:incoming>Flow_distribuir_comercializar_7</bpmn:incoming><bpmn:incoming>Flow_distribuir_comercializar_21</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_22</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="bloquear" name="Bloquear el lote vencido y remitirlo a PR-CO-04" camunda:delegateExpression="${distribucionDelegate}"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="accion">bloquear</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_distribuir_comercializar_6</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Lote bloqueado; remitido a PR-CO-04"><bpmn:incoming>Flow_distribuir_comercializar_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:eventBasedGateway id="eb"><bpmn:incoming>Flow_distribuir_comercializar_22</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_23</bpmn:outgoing><bpmn:outgoing>Flow_distribuir_comercializar_24</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="lote" name="Lote liberado disponible (PR-CO-02)"><bpmn:incoming>Flow_distribuir_comercializar_23</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_25</bpmn:outgoing><bpmn:messageEventDefinition id="MED_lote" messageRef="Message_LoteLiberado" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="espera" name="Espera máxima agotada"><bpmn:documentation>Plazo configurable en application.yaml (agua.plazos.espera-lote). Valor propuesto para operación: P3D.</bpmn:documentation><bpmn:incoming>Flow_distribuir_comercializar_24</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_26</bpmn:outgoing><bpmn:timerEventDefinition id="TED_espera"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${plazoEsperaLote}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="reprog" name="Reprogramar o cancelar el pedido" camunda:formRef="dist_reprogramar" camunda:formRefBinding="deployment" camunda:candidateGroups="bodega"><bpmn:incoming>Flow_distribuir_comercializar_26</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_27</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="¿Reintentar?" default="Flow_distribuir_comercializar_29"><bpmn:incoming>Flow_distribuir_comercializar_27</bpmn:incoming><bpmn:outgoing>Flow_distribuir_comercializar_28</bpmn:outgoing><bpmn:outgoing>Flow_distribuir_comercializar_29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Pedido cancelado sin despacho"><bpmn:incoming>Flow_distribuir_comercializar_29</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_1" sourceRef="s" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_2" sourceRef="registrar" targetRef="consultar" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_3" sourceRef="consultar" targetRef="validar" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_4" sourceRef="validar" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_5" name="Sí" sourceRef="g1" targetRef="a1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${despacho == 'DESPACHAR'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_6" name="Vencido" sourceRef="g1" targetRef="bloquear"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${despacho == 'BLOQUEAR'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_7" name="No" sourceRef="g1" targetRef="demora" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_8" sourceRef="bloquear" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_9" sourceRef="a1" targetRef="alistar" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_10" sourceRef="a1" targetRef="organizar" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_11" sourceRef="alistar" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_12" sourceRef="organizar" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_13" sourceRef="a2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_14" name="Directo" sourceRef="g2" targetRef="entregar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${canal == 'DIRECTO'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_15" name="Distribuidor" sourceRef="g2" targetRef="canal" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_16" sourceRef="entregar" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_17" sourceRef="canal" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_18" sourceRef="g3" targetRef="salida" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_19" sourceRef="salida" targetRef="trasladar" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_20" sourceRef="trasladar" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_21" sourceRef="sinstock" targetRef="demora" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_22" sourceRef="demora" targetRef="eb" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_23" sourceRef="eb" targetRef="lote" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_24" sourceRef="eb" targetRef="espera" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_25" sourceRef="lote" targetRef="consultar" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_26" sourceRef="espera" targetRef="reprog" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_27" sourceRef="reprog" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_28" name="Sí" sourceRef="g4" targetRef="consultar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reintentarStock == true}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_distribuir_comercializar_29" name="No" sourceRef="g4" targetRef="e0" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_distribuir_comercializar">
    <bpmndi:BPMNPlane id="Plane_distribuir_comercializar" bpmnElement="Collab_distribuir_comercializar">
